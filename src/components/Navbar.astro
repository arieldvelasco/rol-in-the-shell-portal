---
import ThemeToggle from './ThemeToggle.astro';

const links = [
	{ href: '/blog', label: 'Blog' },
	{ href: '/resenas', label: 'Reseñas' },
	{ href: '/assets', label: 'Assets' },
];
---

<header
	class="sticky top-0 z-50 border-b border-slate-200 bg-white/80 backdrop-blur dark:border-slate-800 dark:bg-slate-950/80"
>
	<div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-4">
		<a href="/" class="text-lg font-semibold tracking-tight">Rol in the Shell</a>
		<nav class="flex items-center gap-6">
			<ul class="flex gap-6 text-sm font-medium">
				{
					links.map((link) => (
						<li>
							<a href={link.href} class="hover:text-indigo-600 dark:hover:text-indigo-400">
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
			<ThemeToggle />
		</nav>
	</div>
</header>
