---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { tagPillClass } from '../../lib/styles';
import { tutorialCategoriaLabels } from '../../lib/tutorial-categorias';
import ReactionButtons from '../../components/ReactionButtons.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import CommentSection from '../../components/CommentSection.astro';
import ViewTracker from '../../components/ViewTracker.astro';

export async function getStaticPaths() {
	const tutoriales = await getCollection('tutoriales');
	return tutoriales.map((tutorial) => ({
		params: { id: tutorial.id },
		props: { tutorial },
	}));
}

const { tutorial } = Astro.props;
const { Content } = await render(tutorial);
---

<Layout
	title={tutorial.data.title}
	description={tutorial.data.description}
	image={tutorial.data.cover}
	type="article"
	article={{ datePublished: tutorial.data.date }}
>
	<article class="mx-auto max-w-3xl px-4 py-12">
		<span class={tagPillClass}>{tutorialCategoriaLabels[tutorial.data.categoria]}</span>
		<h1 class="mt-2 text-3xl">{tutorial.data.title}</h1>
		<p class="mt-1 text-muted">{tutorial.data.description}</p>

		{
			tutorial.data.cover && (
				<img src={tutorial.data.cover} alt={tutorial.data.title} class="mt-6 aspect-video w-full rounded-md object-cover shadow-md" />
			)
		}

		<div class="prose prose-justify mt-8 max-w-none prose-a:text-accent">
			<Content />
		</div>

		<div class="mt-8 flex flex-wrap items-center justify-between gap-4">
			<ReactionButtons contentType="tutorial" contentSlug={tutorial.id} />
			<ShareButtons title={tutorial.data.title} />
		</div>

		<CommentSection contentType="tutorial" contentSlug={tutorial.id} />
		<ViewTracker contentType="tutorial" contentSlug={tutorial.id} />
	</article>
</Layout>
