---
import { Icon } from 'astro-icon/components';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<div data-share data-share-title={title}>
	<button type="button" data-share-open aria-label="Compartir" class="btn btn-secondary btn-icon">
		<Icon name="ph:share-network" is:inline class="h-4 w-4" aria-hidden="true" />
	</button>

	<dialog data-share-modal data-nc-dialog class="m-auto">
		<div class="flex items-center justify-between">
			<h2 class="dialog-title">Compartir</h2>
			<button type="button" data-share-close aria-label="Cerrar" class="btn btn-ghost btn-icon">
				<Icon name="ph:x" is:inline class="h-4 w-4" aria-hidden="true" />
			</button>
		</div>

		<div class="flex items-center justify-center gap-2">
			<a
				data-share-link="whatsapp"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="Compartir en WhatsApp"
				class="btn btn-secondary btn-icon"
			>
				<Icon name="simple-icons:whatsapp" is:inline class="h-4 w-4" aria-hidden="true" />
			</a>
			<a
				data-share-link="x"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="Compartir en X"
				class="btn btn-secondary btn-icon"
			>
				<Icon name="simple-icons:x" is:inline class="h-4 w-4" aria-hidden="true" />
			</a>
			<a
				data-share-link="facebook"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="Compartir en Facebook"
				class="btn btn-secondary btn-icon"
			>
				<Icon name="simple-icons:facebook" is:inline class="h-4 w-4" aria-hidden="true" />
			</a>
			<button
				type="button"
				data-share-instagram
				aria-label="Copiar enlace para compartir en Instagram"
				title="Instagram no permite compartir un link directo: copia el enlace y abre Instagram para pegarlo en tu historia o DM"
				class="btn btn-secondary btn-icon"
			>
				<Icon name="simple-icons:instagram" is:inline class="h-4 w-4" aria-hidden="true" />
			</button>
		</div>

		<div class="flex items-center gap-2">
			<input data-share-url-input type="text" readonly class="input" />
			<button type="button" data-share-copy aria-label="Copiar enlace" class="btn btn-secondary btn-icon flex-shrink-0">
				<Icon name="ph:link-simple" is:inline data-copy-icon-default class="h-4 w-4" aria-hidden="true" />
				<Icon name="ph:check" is:inline data-copy-icon-success style="display: none" class="h-4 w-4" aria-hidden="true" />
			</button>
		</div>
	</dialog>
</div>

<script>
	document.querySelectorAll<HTMLElement>('[data-share]').forEach((container) => {
		const title = container.dataset.shareTitle ?? '';
		const url = window.location.href;
		const encodedUrl = encodeURIComponent(url);
		const encodedTitle = encodeURIComponent(title);

		const shareUrls: Record<string, string> = {
			whatsapp: `https://wa.me/?text=${encodedTitle}%20${encodedUrl}`,
			x: `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`,
			facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
		};

		container.querySelectorAll<HTMLAnchorElement>('[data-share-link]').forEach((link) => {
			const network = link.dataset.shareLink!;
			link.href = shareUrls[network];
		});

		const urlInput = container.querySelector<HTMLInputElement>('[data-share-url-input]')!;
		urlInput.value = url;

		const modal = container.querySelector<HTMLDialogElement>('[data-share-modal]')!;
		const openButton = container.querySelector<HTMLButtonElement>('[data-share-open]')!;
		const closeButton = container.querySelector<HTMLButtonElement>('[data-share-close]')!;

		openButton.addEventListener('click', () => modal.showModal());
		closeButton.addEventListener('click', () => modal.close());
		modal.addEventListener('click', (event) => {
			if (event.target === modal) modal.close();
		});

		function copyFallback(text: string): boolean {
			const input = document.createElement('textarea');
			input.value = text;
			input.style.position = 'fixed';
			input.style.opacity = '0';
			document.body.appendChild(input);
			input.select();
			const ok = document.execCommand('copy');
			input.remove();
			return ok;
		}

		async function copyUrl(): Promise<boolean> {
			try {
				await navigator.clipboard.writeText(url);
				return true;
			} catch {
				return copyFallback(url);
			}
		}

		const copyButton = container.querySelector<HTMLButtonElement>('[data-share-copy]')!;
		const copyIconDefault = copyButton.querySelector<HTMLElement>('[data-copy-icon-default]')!;
		const copyIconSuccess = copyButton.querySelector<HTMLElement>('[data-copy-icon-success]')!;
		const copyDefaultLabel = copyButton.getAttribute('aria-label')!;

		// Se usa style.display (no la clase `hidden`) porque `.btn svg { display:
		// block }` en global.css tiene más especificidad que `.hidden` y la
		// pisaría, dejando los dos íconos visibles siempre.
		copyButton.addEventListener('click', async () => {
			const copied = await copyUrl();
			copyIconDefault.style.display = copied ? 'none' : '';
			copyIconSuccess.style.display = copied ? '' : 'none';
			copyButton.setAttribute('aria-label', copied ? '¡Copiado!' : 'No se pudo copiar');
			setTimeout(() => {
				copyIconDefault.style.display = '';
				copyIconSuccess.style.display = 'none';
				copyButton.setAttribute('aria-label', copyDefaultLabel);
			}, 1200);
		});

		const instagramButton = container.querySelector<HTMLButtonElement>('[data-share-instagram]')!;
		const instagramDefaultLabel = instagramButton.getAttribute('aria-label')!;

		instagramButton.addEventListener('click', async () => {
			const copied = await copyUrl();
			instagramButton.setAttribute('aria-label', copied ? 'Enlace copiado, abriendo Instagram…' : 'No se pudo copiar el enlace');
			setTimeout(() => instagramButton.setAttribute('aria-label', instagramDefaultLabel), 1200);
			if (copied) window.open('https://www.instagram.com/', '_blank', 'noopener,noreferrer');
		});
	});
</script>
