---
import type { CollectionEntry } from 'astro:content';
import { tagPillClass } from '../lib/styles';

interface Props {
	resena: CollectionEntry<'resenas'>;
}

const { resena } = Astro.props;
const formattedDate = resena.data.date.toLocaleDateString('es-AR', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
	timeZone: 'UTC',
});
---

<li data-sistema={resena.data.sistema}>
	<a href={`/resenas/${resena.id}`} class="card shadow-sm transition hover:shadow-md">
		<time datetime={resena.data.date.toISOString()} class="card-meta">{formattedDate}</time>
		<h2 class="card-title">{resena.data.title}</h2>
		<p class="card-body">
			{resena.data.producto} — {resena.data.editorial}
		</p>

		<div class="flex items-end justify-between gap-2">
			<ul class="flex flex-wrap gap-2">
				<li class={tagPillClass}>{resena.data.sistema}</li>
				{resena.data.tags.map((tag) => <li class={tagPillClass}>{tag}</li>)}
			</ul>
			<span class="shrink-0 text-sm font-semibold text-accent">{resena.data.puntuacion}/10</span>
		</div>
	</a>
</li>
