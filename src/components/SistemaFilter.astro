---
// Filtro cliente por sistema. Busca los sistemas disponibles a partir del
// contenido publicado (no hardcodeados) y filtra los <li data-sistema="...">
// dentro del contenedor indicado por `listId`.

interface Props {
	sistemas: string[];
	listId: string;
}

const { sistemas, listId } = Astro.props;
---

<div class="mb-8 flex flex-wrap gap-2" data-sistema-filter data-list-id={listId}>
	<button type="button" data-sistema-option="todos" aria-pressed="true" class="btn btn-primary">
		Todos
	</button>
	{
		sistemas.map((sistema) => (
			<button type="button" data-sistema-option={sistema} aria-pressed="false" class="btn btn-secondary">
				{sistema}
			</button>
		))
	}
</div>

<script>
	document.querySelectorAll<HTMLElement>('[data-sistema-filter]').forEach((filter) => {
		const listId = filter.dataset.listId;
		const list = listId ? document.getElementById(listId) : null;
		if (!list) return;

		const buttons = filter.querySelectorAll<HTMLButtonElement>('[data-sistema-option]');

		buttons.forEach((button) => {
			button.addEventListener('click', () => {
				const selected = button.dataset.sistemaOption;

				buttons.forEach((b) => {
					const isSelected = b === button;
					b.setAttribute('aria-pressed', String(isSelected));
					b.classList.toggle('btn-primary', isSelected);
					b.classList.toggle('btn-secondary', !isSelected);
				});

				list.querySelectorAll<HTMLElement>('[data-sistema]').forEach((item) => {
					const matches = selected === 'todos' || item.dataset.sistema === selected;
					item.classList.toggle('hidden', !matches);
				});
			});
		});
	});
</script>
