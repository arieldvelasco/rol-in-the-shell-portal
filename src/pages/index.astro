---
import Layout from '../layouts/Layout.astro';
import TopLikedPosts from '../components/TopLikedPosts.astro';
import { getAllEntries, getLatestEntries } from '../lib/latest-entries';

const allEntries = await getAllEntries();
const latestEntries = await getLatestEntries(6);
---

<Layout title="Inicio">
	<section class="mx-auto max-w-5xl px-4 py-20 text-center">
		<h1 class="text-4xl font-bold tracking-tight sm:text-5xl">Rol in the Shell</h1>
		<p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600 dark:text-slate-400">
			Blog de opinión y reseñas, y assets para GMs y jugadores: personajes, NPCs, mapas, aventuras y
			tablas.
		</p>
	</section>

	{
		latestEntries.length > 0 && (
			<section class="mx-auto max-w-5xl px-4 pb-20">
				<div class="grid gap-8 lg:grid-cols-[2fr_1fr]">
					<div>
						<h2 class="mb-6 text-2xl font-semibold">Últimas entradas</h2>
						<ul class="space-y-4">
							{latestEntries.map((entry) => (
								<li>
									<a
										href={entry.href}
										class="flex items-center justify-between gap-4 rounded-lg border border-slate-200 p-4 hover:border-indigo-400 dark:border-slate-800 dark:hover:border-indigo-500"
									>
										<span class="font-medium">{entry.title}</span>
										<span class="shrink-0 rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-600 dark:bg-slate-800 dark:text-slate-300">
											{entry.kind}
										</span>
									</a>
								</li>
							))}
						</ul>
					</div>
					<TopLikedPosts entries={allEntries} />
				</div>
			</section>
		)
	}
</Layout>
