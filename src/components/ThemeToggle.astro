---
// Botón de alternancia de tema. La lógica de aplicar el tema al cargar
// vive en Layout.astro (script inline, corre antes del primer paint).
---

<button
	id="theme-toggle"
	type="button"
	aria-label="Cambiar entre modo claro y oscuro"
	class="rounded-md p-2 text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800"
>
	<svg
		id="theme-toggle-icon-light"
		xmlns="http://www.w3.org/2000/svg"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		class="hidden h-5 w-5 dark:block"
	>
		<circle cx="12" cy="12" r="4" />
		<path
			d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
		/>
	</svg>
	<svg
		id="theme-toggle-icon-dark"
		xmlns="http://www.w3.org/2000/svg"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		class="block h-5 w-5 dark:hidden"
	>
		<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
	</svg>
</button>

<script>
	const STORAGE_KEY = 'theme';

	function applyTheme(theme: 'light' | 'dark') {
		document.documentElement.classList.toggle('dark', theme === 'dark');
		localStorage.setItem(STORAGE_KEY, theme);
	}

	document.getElementById('theme-toggle')?.addEventListener('click', () => {
		const isDark = document.documentElement.classList.contains('dark');
		applyTheme(isDark ? 'light' : 'dark');
	});
</script>
