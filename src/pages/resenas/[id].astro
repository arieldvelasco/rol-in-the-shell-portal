---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { tagPillClass } from '../../lib/styles';
import ReactionButtons from '../../components/ReactionButtons.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import CommentSection from '../../components/CommentSection.astro';
import ViewTracker from '../../components/ViewTracker.astro';

export async function getStaticPaths() {
	const resenas = await getCollection('resenas');
	return resenas.map((resena) => ({
		params: { id: resena.id },
		props: { resena },
	}));
}

const { resena } = Astro.props;
const { Content } = await render(resena);
---

<Layout
	title={resena.data.title}
	description={`Reseña de ${resena.data.producto}`}
	image={resena.data.cover}
	type="article"
	article={{ datePublished: resena.data.date }}
>
	<article class="mx-auto max-w-3xl px-4 py-12">
		<div class="flex items-center gap-3">
			<span class={tagPillClass}>{resena.data.sistema}</span>
			<span class="text-sm font-semibold text-accent">{resena.data.puntuacion}/10</span>
		</div>
		<h1 class="mt-2 text-3xl">{resena.data.title}</h1>
		<p class="mt-1 text-muted">
			{resena.data.producto} — {resena.data.editorial}
		</p>

		<div class="mt-8 grid gap-4 sm:grid-cols-2">
			<div class="card">
				<h2 class="card-title text-green-500">Pros</h2>
				<ul class="mt-1 list-inside list-disc text-sm text-muted marker:text-green-500">
					{resena.data.pros.map((pro) => <li>{pro}</li>)}
				</ul>
			</div>
			<div class="card">
				<h2 class="card-title text-red-500">Contras</h2>
				<ul class="mt-1 list-inside list-disc text-sm text-muted marker:text-red-500">
					{resena.data.contras.map((contra) => <li>{contra}</li>)}
				</ul>
			</div>
		</div>

		<div class="prose prose-justify mt-8 max-w-none prose-a:text-accent">
			<Content />
		</div>

		<div class="mt-8 flex flex-wrap items-center justify-between gap-4">
			<ReactionButtons contentType="resena" contentSlug={resena.id} />
			<ShareButtons title={resena.data.title} />
		</div>

		<CommentSection contentType="resena" contentSlug={resena.id} />
		<ViewTracker contentType="resena" contentSlug={resena.id} />
	</article>
</Layout>
