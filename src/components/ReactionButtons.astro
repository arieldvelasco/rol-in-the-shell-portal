---
interface Props {
	contentType: 'blog' | 'resena' | 'asset';
	contentSlug: string;
}

const { contentType, contentSlug } = Astro.props;
---

<div
	data-reactions
	data-content-type={contentType}
	data-content-slug={contentSlug}
	class="inline-flex items-center rounded-md border border-indigo-600 overflow-hidden"
>
	<button
		type="button"
		data-reaction-kind="like"
		aria-pressed="false"
		class="flex items-center gap-[8px] px-[15px] py-[8px] text-[18px] text-slate-600 transition-colors hover:bg-indigo-600 hover:text-white dark:text-slate-300"
	>
		<span aria-hidden="true">👍</span>
		<span data-reaction-count="like">0</span>
	</button>
	<button
		type="button"
		data-reaction-kind="dislike"
		aria-pressed="false"
		class="flex items-center gap-[8px] border-l border-indigo-600 px-[15px] py-[8px] text-[18px] text-slate-600 transition-colors hover:bg-indigo-600 hover:text-white dark:text-slate-300"
	>
		<span aria-hidden="true">👎</span>
		<span data-reaction-count="dislike">0</span>
	</button>
</div>

<script>
	import { supabase } from '../lib/supabase';
	import { getFingerprint } from '../lib/fingerprint';

	const ACTIVE_CLASSES = ['bg-indigo-600', 'text-white', 'dark:text-white'];

	document.querySelectorAll<HTMLElement>('[data-reactions]').forEach(async (container) => {
		const contentType = container.dataset.contentType!;
		const contentSlug = container.dataset.contentSlug!;
		const fingerprint = getFingerprint();
		const buttons = container.querySelectorAll<HTMLButtonElement>('[data-reaction-kind]');

		async function refresh() {
			const { data: rows } = await supabase
				.from('reactions')
				.select('kind, fingerprint')
				.eq('content_type', contentType)
				.eq('content_slug', contentSlug);

			const counts = { like: 0, dislike: 0 };
			let ownReaction: string | null = null;
			for (const row of rows ?? []) {
				counts[row.kind as 'like' | 'dislike']++;
				if (row.fingerprint === fingerprint) ownReaction = row.kind;
			}

			buttons.forEach((button) => {
				const kind = button.dataset.reactionKind as 'like' | 'dislike';
				container.querySelector(`[data-reaction-count="${kind}"]`)!.textContent = String(counts[kind]);
				const isActive = ownReaction === kind;
				button.setAttribute('aria-pressed', String(isActive));
				ACTIVE_CLASSES.forEach((c) => button.classList.toggle(c, isActive));
			});
		}

		buttons.forEach((button) => {
			button.addEventListener('click', async () => {
				const kind = button.dataset.reactionKind as 'like' | 'dislike';
				const isActive = button.getAttribute('aria-pressed') === 'true';

				if (isActive) {
					await supabase
						.from('reactions')
						.delete()
						.match({ content_type: contentType, content_slug: contentSlug, fingerprint, kind });
				} else {
					await supabase
						.from('reactions')
						.delete()
						.match({ content_type: contentType, content_slug: contentSlug, fingerprint });
					await supabase
						.from('reactions')
						.insert({ content_type: contentType, content_slug: contentSlug, fingerprint, kind });
				}

				await refresh();
			});
		});

		await refresh();
	});
</script>
