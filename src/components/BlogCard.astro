---
import type { CollectionEntry } from 'astro:content';
import { tagPillClass } from '../lib/styles';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const formattedDate = post.data.date.toLocaleDateString('es-AR', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
	timeZone: 'UTC',
});
---

<a
	href={`/blog/${post.id}`}
	class="block rounded-lg border border-slate-200 p-5 transition hover:border-indigo-400 hover:shadow-sm dark:border-slate-800 dark:hover:border-indigo-500"
>
	<time datetime={post.data.date.toISOString()} class="text-xs text-slate-500 dark:text-slate-400">
		{formattedDate}
	</time>
	<h2 class="mt-1 text-lg font-semibold">{post.data.title}</h2>
	<p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{post.data.description}</p>
	{
		post.data.tags.length > 0 && (
			<ul class="mt-3 flex flex-wrap gap-2">
				{post.data.tags.map((tag) => (
					<li class={tagPillClass}>{tag}</li>
				))}
			</ul>
		)
	}
</a>
