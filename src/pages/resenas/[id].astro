---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { tagPillClass } from '../../lib/styles';
import ReactionButtons from '../../components/ReactionButtons.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import CommentSection from '../../components/CommentSection.astro';
import ViewTracker from '../../components/ViewTracker.astro';

export async function getStaticPaths() {
	const resenas = await getCollection('resenas');
	return resenas.map((resena) => ({
		params: { id: resena.id },
		props: { resena },
	}));
}

const { resena } = Astro.props;
const { Content } = await render(resena);
---

<Layout title={resena.data.title} description={`Reseña de ${resena.data.producto}`}>
	<article class="mx-auto max-w-3xl px-4 py-12">
		<div class="flex items-center gap-3">
			<span class={tagPillClass}>{resena.data.sistema}</span>
			<span class="text-sm font-semibold text-indigo-600 dark:text-indigo-400">
				{resena.data.puntuacion}/10
			</span>
		</div>
		<h1 class="mt-2 text-3xl font-bold tracking-tight">{resena.data.title}</h1>
		<p class="mt-1 text-slate-600 dark:text-slate-400">
			{resena.data.producto} — {resena.data.editorial}
		</p>

		<div class="mt-8 grid gap-4 sm:grid-cols-2">
			<div class="rounded-lg border border-slate-200 p-4 dark:border-slate-800">
				<h2 class="font-semibold text-emerald-600 dark:text-emerald-400">Pros</h2>
				<ul class="mt-2 list-inside list-disc text-sm text-slate-600 dark:text-slate-400">
					{resena.data.pros.map((pro) => <li>{pro}</li>)}
				</ul>
			</div>
			<div class="rounded-lg border border-slate-200 p-4 dark:border-slate-800">
				<h2 class="font-semibold text-rose-600 dark:text-rose-400">Contras</h2>
				<ul class="mt-2 list-inside list-disc text-sm text-slate-600 dark:text-slate-400">
					{resena.data.contras.map((contra) => <li>{contra}</li>)}
				</ul>
			</div>
		</div>

		<div
			class="prose prose-slate prose-justify mt-8 max-w-none dark:prose-invert prose-a:text-indigo-600 dark:prose-a:text-indigo-400"
		>
			<Content />
		</div>

		<div class="mt-8 flex flex-wrap items-center justify-between gap-4">
			<ReactionButtons contentType="resena" contentSlug={resena.id} />
			<ShareButtons title={resena.data.title} />
		</div>

		<CommentSection contentType="resena" contentSlug={resena.id} />
		<ViewTracker contentType="resena" contentSlug={resena.id} />
	</article>
</Layout>
