---
import type { CollectionEntry } from 'astro:content';
import { tagPillClass } from '../lib/styles';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const formattedDate = post.data.date.toLocaleDateString('es-AR', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
	timeZone: 'UTC',
});
---

<a href={`/blog/${post.id}`} class="card shadow-sm transition hover:shadow-md">
	<time datetime={post.data.date.toISOString()} class="card-meta">{formattedDate}</time>
	<h2 class="card-title">{post.data.title}</h2>
	<p class="card-body">{post.data.description}</p>
	{
		post.data.tags.length > 0 && (
			<ul class="flex flex-wrap gap-2">
				{post.data.tags.map((tag) => (
					<li class={tagPillClass}>{tag}</li>
				))}
			</ul>
		)
	}
</a>
