---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { assetTipos, assetTipoLabels } from '../../lib/asset-tipos';

const assets = await getCollection('assets');
const countByTipo = Object.fromEntries(
	assetTipos.map((tipo) => [tipo, assets.filter((a) => a.data.tipo === tipo).length])
);
---

<Layout title="Assets" description="Personajes, NPCs, mapas, aventuras y tablas listas para tu mesa.">
	<section class="mx-auto max-w-5xl px-4 py-12">
		<h1 class="text-3xl">Assets</h1>
		<p class="mt-2 text-muted">Personajes, NPCs, mapas, tablas y aventuras, listos para bajar y usar en tu mesa.</p>

		<ul class="mt-8 grid gap-4 sm:grid-cols-2">
			{
				assetTipos.map((tipo) => (
					<li>
						<a href={`/assets/${tipo}`} class="card shadow-sm transition hover:shadow-md">
							<h2 class="card-title">{assetTipoLabels[tipo]}</h2>
							<p class="card-body">{countByTipo[tipo]} disponibles</p>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Layout>
