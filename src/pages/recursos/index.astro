---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { recursoTipos, recursoTipoLabels } from '../../lib/recurso-tipos';

const recursos = await getCollection('recursos');
const countByTipo = Object.fromEntries(
	recursoTipos.map((tipo) => [tipo, recursos.filter((r) => r.data.tipo === tipo).length])
);
---

<Layout title="Recursos" description="Personajes, NPCs, mapas, aventuras y tablas listas para tu mesa.">
	<section class="mx-auto max-w-5xl px-4 py-12">
		<h1 class="text-3xl">Recursos</h1>
		<p class="mt-2 text-muted">Personajes, NPCs, mapas, tablas y aventuras, listos para descargarlos y usarlos en tu mesa.</p>

		<ul class="mt-8 grid gap-4 sm:grid-cols-2">
			{
				recursoTipos.map((tipo) => (
					<li>
						<a href={`/recursos/${tipo}`} class="card shadow-sm transition hover:shadow-md">
							<h2 class="card-title">{recursoTipoLabels[tipo]}</h2>
							<p class="card-body">{countByTipo[tipo]} disponibles</p>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Layout>
