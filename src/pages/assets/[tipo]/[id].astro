---
import Layout from '../../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { tagPillClass } from '../../../lib/styles';
import ReactionButtons from '../../../components/ReactionButtons.astro';
import ShareButtons from '../../../components/ShareButtons.astro';
import CommentSection from '../../../components/CommentSection.astro';
import ViewTracker from '../../../components/ViewTracker.astro';

export async function getStaticPaths() {
	const assets = await getCollection('assets');
	return assets.map((asset) => ({
		params: { tipo: asset.data.tipo, id: asset.id },
		props: { asset },
	}));
}

const { asset } = Astro.props;
const { Content } = await render(asset);
---

<Layout title={asset.data.title} description={asset.data.description ?? asset.data.title}>
	<article class="mx-auto max-w-3xl px-4 py-12">
		<div class="flex items-center gap-3">
			<span class={tagPillClass}>{asset.data.sistema}</span>
			{asset.data.nivel !== undefined && <span class="text-xs text-muted">Nivel {asset.data.nivel}</span>}
		</div>

		<h1 class="mt-2 text-3xl">{asset.data.title}</h1>

		{asset.data.description && <p class="mt-2 text-muted">{asset.data.description}</p>}

		{
			asset.data.cover && (
				<img src={asset.data.cover} alt="" class="mt-6 aspect-video w-full rounded-md object-cover shadow-md" />
			)
		}

		<div class="prose prose-justify mt-8 max-w-none prose-a:text-accent">
			<Content />
		</div>

		<div class="mt-8 flex flex-wrap items-center justify-between gap-4">
			<ReactionButtons contentType="asset" contentSlug={asset.id} />
			<ShareButtons title={asset.data.title} />
		</div>

		<CommentSection contentType="asset" contentSlug={asset.id} />
		<ViewTracker contentType="asset" contentSlug={asset.id} />
	</article>
</Layout>
