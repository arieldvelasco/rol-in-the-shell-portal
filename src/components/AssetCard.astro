---
import type { CollectionEntry } from 'astro:content';
import { tagPillClass } from '../lib/styles';

interface Props {
	asset: CollectionEntry<'assets'>;
}

const { asset } = Astro.props;
---

<li data-sistema={asset.data.sistema}>
	<a href={`/assets/${asset.data.tipo}/${asset.id}`} class="card shadow-sm transition hover:shadow-md">
		{
			asset.data.cover && (
				<img
					src={asset.data.cover}
					alt=""
					class="-mx-4 -mt-4 mb-1 aspect-video w-[calc(100%+32px)] rounded-t-md object-cover"
				/>
			)
		}
		<div class="flex justify-end">
			<span class={tagPillClass}>{asset.data.sistema}</span>
		</div>
		<h2 class="card-title">{asset.data.title}</h2>
		{asset.data.description && <p class="card-body">{asset.data.description}</p>}
	</a>
</li>
