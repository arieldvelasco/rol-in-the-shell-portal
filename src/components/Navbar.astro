---
import ThemeToggle from './ThemeToggle.astro';

const links = [
	{ href: '/blog', label: 'Blog' },
	{ href: '/resenas', label: 'Reseñas' },
	{ href: '/tutoriales', label: 'Tutoriales' },
	{ href: '/recursos', label: 'Recursos' },
];
---

<header class="sticky top-0 z-50 border-b border-divider bg-bg/80 backdrop-blur">
	<div class="nav mx-auto max-w-5xl">
		<a href="/" class="nav-brand">Rol in the Shell</a>
		<ul class="flex gap-6">
			{
				links.map((link) => (
					<li>
						<a href={link.href}>{link.label}</a>
					</li>
				))
			}
		</ul>
		<ThemeToggle />
	</div>
</header>
