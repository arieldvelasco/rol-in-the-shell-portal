---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada" description="La página que buscás no existe o se movió.">
	<section class="mx-auto max-w-5xl px-4 py-20 text-center">
		<h1 class="text-5xl">404</h1>
		<p class="mt-4 text-lg text-muted">La página que buscás no existe o se movió.</p>
		<div class="mt-6 flex justify-center gap-3">
			<a href="/" class="btn btn-primary">Volver al inicio</a>
		</div>
	</section>
</Layout>
